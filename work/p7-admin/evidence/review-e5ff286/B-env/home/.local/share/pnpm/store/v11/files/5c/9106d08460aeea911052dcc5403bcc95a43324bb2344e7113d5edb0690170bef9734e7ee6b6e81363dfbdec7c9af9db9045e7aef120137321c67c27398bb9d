{
  "name": "@deepseek-ai/dsh-experimental-voice-input-bundle",
  "description": "Experimental voice input with local SenseVoice; downloads its runtime on first use",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
