  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "~1.0.11-alpha.1",
