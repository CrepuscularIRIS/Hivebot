{
  "name": "@deepseek-ai/dsh-plugin-recommendations",
  "description": "Official plugin suggestions with explicit user activation and persistent conversation decisions",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/plugin-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.2-alpha.2"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@deepseek-ai/dsh-client-ui-plugin-recommendations": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-action-cards": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-action-cards": "0.2.2-alpha.2"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "icon": "./icon.svg"
}