{
  "name": "p2sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P2 demo vertical slice on @deepseek-ai/dsh (web profile, npm pinned)",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.9.0 <25",
      "onFail": "download"
    }
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-market": "0.2.2-alpha.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-replay": "0.2.2-alpha.2",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "koffi",
      "node",
      "node-pty",
      "protobufjs"
    ]
  }
}
