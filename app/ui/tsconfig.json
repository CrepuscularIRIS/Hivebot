{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "renderer/**/*.ts", "tests/**/*.ts", "electron.vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
