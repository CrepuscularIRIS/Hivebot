{
  "name": "@deepseek-ai/dsh-cua-bundle",
  "description": "Optional macOS Computer Use and permission setup",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "listedByDefault": false,
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-computer-use": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-cua": "0.2.2-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "~1.0.11-alpha.1",
    "js-yaml": "^4.2.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.7-alpha.1"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-experimental-cua-macos": "0.2.2-alpha.2"
  }
}