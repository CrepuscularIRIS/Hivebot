{
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "name": "@deepseek-ai/dsh-client-ui-plugin-recommendations",
  "description": "Official plugin card body with catalog text and enabling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-plugin-recommendations"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-action-cards"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-plugin-recommendations": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-action-cards": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-action-cards": "0.2.2-alpha.2",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-alpha.2"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}