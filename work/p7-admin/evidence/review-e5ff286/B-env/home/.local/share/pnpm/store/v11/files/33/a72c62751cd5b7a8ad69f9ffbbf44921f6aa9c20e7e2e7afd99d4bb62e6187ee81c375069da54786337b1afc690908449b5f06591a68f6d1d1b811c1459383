    "@deepseek-ai/dsh-tool-ask-user": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-present": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-file-reference-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-deliverable-file-references": "0.2.2-alpha.2"
